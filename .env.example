# =============================================================================
# Abeta Dynamic Layout Engine — Environment Configuration Example
# Copy to `.env` for local overrides (`.env` is gitignored).
# =============================================================================

# --- HTTP Server ---
SERVICE_NAME=abeta-layout-engine
PORT=8090
HTTP_ADDR=:8090
GIN_MODE=release
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
CORS_ALLOWED_ORIGINS=*

# --- Database (Zero-Config SQLite Default) ---
DB_DIALECT=sqlite
DB_DSN=file:layout-engine.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)

# --- Database (Production PostgreSQL 17 Example — used by docker-compose.yaml) ---
# DB_DIALECT=postgres
# DB_DSN=postgres://layout:layout@postgres:5432/layout_engine?sslmode=disable

# --- Bootstrapping & Multi-Tenant Defaults ---
AUTO_MIGRATE=true
SEED_STARTER_DATA=true
DEFAULT_TENANT=abeta-fresh
TOKEN_CATALOG_VERSION=1.0.0

# --- Transport Optimization ---
COMPRESSION_ENABLED=true
ETAG_ENABLED=true

# --- Security & TLS (Optional) ---
RATE_LIMIT_ENABLED=false
AUTH_REQUIRED=false
# JWT_SECRET=
# TLS_CERT_FILE=
# TLS_KEY_FILE=
